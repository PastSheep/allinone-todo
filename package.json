{
  "name": "allinone-todo",
  "version": "0.1.0",
  "private": true,
  "description": "AllInOne example todo plugin distributed from its own GitHub repository",
  "license": "MIT",
  "author": {
    "name": "PastSheep",
    "url": "https://github.com/PastSheep"
  },
  "allinone": {
    "manifest": "allinone.json"
  },
  "scripts": {
    "build:host": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.js",
    "build:ui": "esbuild src/ui.ts --bundle --platform=browser --format=esm --target=chrome130 --outfile=dist/ui.js",
    "build": "pnpm run build:host && pnpm run build:ui",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
